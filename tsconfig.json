{
  "compilerOptions": {
    "outDir": "es",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "declaration": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],
  // Stories are dev-only — keeping them out of the emit means they are not
  // published in `es/`. They are still type-checked via tsconfig.storybook.json.
  "exclude": [
    "src/**/*.stories.tsx",
    "src/**/*.mdx",
    "src/theme/stories"
  ]
}
