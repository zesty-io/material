{
  "name": "@zesty-io/material",
  "version": "0.16.3",
  "description": "Contains custom components which are in addition to the @mui design-system",
  "author": "Zesty.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zesty-io/material.git"
  },
  "bugs": {
    "url": "https://github.com/zesty-io/material/issues"
  },
  "homepage": "https://zesty-io.github.io/material",
  "volta": {
    "node": "20.19.0"
  },
  "main": "./cjs/index.js",
  "module": "./es/index.js",
  "types": "./es/index.d.ts",
  "scripts": {
    "prepare": "husky || true",
    "build": "npm ci && tsc",
    "prerelease": "npm test",
    "release": "npm run build && npm publish --access public",
    "release:alpha": "npm run build && npm publish --access public --tag alpha",
    "postrelease": "rm -rf /es",
    "deploy": "npm run build-storybook && gh-pages -d storybook-static",
    "test": "echo 'add tests'",
    "typecheck": "tsc -p tsconfig.storybook.json",
    "lint": "eslint src",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "gen:m3": "node scripts/generate-m3-tokens.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.1",
    "@mui/lab": "^7.0.0-beta.10",
    "@mui/material": "^7.0.1",
    "@mui/x-data-grid-pro": "^7.28.3",
    "@mui/x-date-pickers-pro": "^7.28.3",
    "@mui/x-tree-view": "^7.28.1",
    "date-fns": "^2.28.0",
    "react-window": "^1.8.7"
  },
  "devDependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-links": "^10.5.3",
    "@storybook/react-vite": "^10.5.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "pretty-quick": "^4.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.5.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.1.0"
  },
  "files": [
    "cjs",
    "es"
  ]
}
